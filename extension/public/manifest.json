{
  "manifest_version": 3,
  "name": "SURFBOARD Terminal",
  "short_name": "SURFBOARD",
  "version": "0.1.0",
  "description": "A native terminal tab and side panel for Chrome.",
  "permissions": ["nativeMessaging", "sidePanel"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open SURFBOARD terminal"
  },
  "side_panel": {
    "default_path": "terminal.html"
  },
  "commands": {
    "open-terminal-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open SURFBOARD in a new browser tab"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
